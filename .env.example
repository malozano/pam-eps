# Copiar a .env.local y rellenar con los datos del proyecto Supabase
# (Project Settings > API). La clave publishable/anon es pública por diseño:
# la seguridad la garantizan las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
